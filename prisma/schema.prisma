// Familientisch — Datenmodell (Grundgerüst)
// Deckt alle in fahrplan_v2.md / fragenkatalog.md entschiedenen Bereiche ab.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Personen & Login ----------

enum Rolle {
  ELTERN
  KIND
  KIND_OHNE_ZUGANG // z.B. Ayla: verwaltet, aber kein eigener Login
}

model Person {
  id          String   @id @default(cuid())
  name        String
  rolle       Rolle
  farbe       String   @default("#8a7a63")
  pinHash     String? // nur gesetzt, wenn rolle Login erlaubt
  aktiv       Boolean  @default(true)
  reihenfolge Int      @default(0)
  // Portionsgröße für den Essensplan-Skalierungsrechner (Fix-Batch 23) — vorher fest im
  // Code hinterlegt (Flo 1.5, Ayla 0.5, Rest 1), jetzt in den Einstellungen editierbar.
  portionsGewicht Float @default(1)
  // Für den Ferien-Countdown und die Schuljahr-Zuordnung (Fix-Batch 27) — nur für Kinder
  // relevant, in den Einstellungen von jedem Kind selbst wählbar.
  bundesland    String?
  klassenstufe  Int?
  klasse        String? // z.B. "5a"
  // Geburtstag (Fix-Batch 30) — erscheint dann automatisch im Kalender ALLER Familienmitglieder.
  geburtsdatum  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions           Session[]
  termineErstellt    Termin[]           @relation("TerminErsteller")
  termine            Termin[]           @relation("TerminPerson")
  terminHistorie     AenderungsLog[]    @relation("AenderungVon")
  aufgaben           Aufgabe[]          @relation("AufgabePerson")
  aufgabenErstellt   Aufgabe[]          @relation("AufgabeErsteller")
  einkaufsWuensche   EinkaufsWunsch[]
  faecher            Fach[]
  noten              Note[]
  notenGewichtungen  NotenGewichtung[]
  taschengeld        TaschengeldTransaktion[]
  sparziel           Sparziel?
  dienstZuweisungen  DienstZuweisung[]
  dienstTauscheVon   DienstTausch[]     @relation("DienstTauschVon")
  dienstTauscheMit   DienstTausch[]     @relation("DienstTauschMit")
  badZuweisungen     BadZuweisung[]
  pushSubscriptions  PushSubscription[]
  schulEintraege     SchulEintrag[]     @relation("SchulEintragPerson")
  tickets            Ticket[]
}

model Session {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ---------- Generische Änderungshistorie ----------
// Umfang laut Entscheidung (Runde 5): Noten, Taschengeld, Termine, Aufgaben,
// Dienst-Tausch, Einkaufs-Wünsche — NICHT die laufende Einkaufslisten-Pflege selbst.

enum EntityTyp {
  TERMIN
  AUFGABE
  NOTE
  TASCHENGELD
  DIENST_TAUSCH
  EINKAUFS_WUNSCH
}

model AenderungsLog {
  id          String    @id @default(cuid())
  entityTyp   EntityTyp
  entityId    String
  aktion      String // z.B. "erstellt", "geaendert", "geloescht", "genehmigt", "abgelehnt"
  feld        String? // bei "geaendert": welches Feld
  alterWert   String?
  neuerWert   String?
  geaendertVonId String
  geaendertVon   Person @relation("AenderungVon", fields: [geaendertVonId], references: [id])
  zeitpunkt   DateTime  @default(now())

  @@index([entityTyp, entityId])
}

// ---------- Kalender ----------

enum TerminKategorie {
  TERMIN
  HOBBY
  AUSFLUG
  SCHULE
  DIENST
}

enum Wiederholung {
  KEINE
  TAEGLICH
  WERKTAEGLICH // Mo-Fr (Fix-Batch 30)
  WOECHENTLICH
  ZWEIWOECHENTLICH
  MONATLICH
  ALLE_3_MONATE // Fix-Batch 30
  JAEHRLICH // Fix-Batch 30
}

model Termin {
  id                  String          @id @default(cuid())
  titel               String
  beschreibung        String?
  start               DateTime
  ende                DateTime?
  ganztaegig          Boolean         @default(false)
  kategorie           TerminKategorie @default(TERMIN)
  personId            String? // null = familienweit
  person              Person?         @relation("TerminPerson", fields: [personId], references: [id])
  seriesId            String?
  // Gemeinsame ID über alle Personen-Zeilen EINES Anlege-Vorgangs (Fix-Batch 30) — damit
  // ein Termin für mehrere Personen im Eltern-Kalender als EIN Eintrag mit allen Personen
  // angezeigt werden kann statt einmal pro Person dupliziert.
  gruppeId            String?
  wiederholung        Wiederholung    @default(KEINE)
  wiederholungBis     DateTime?
  erinnerungGesendet  Boolean         @default(false)
  erstelltVonId       String
  erstelltVon         Person          @relation("TerminErsteller", fields: [erstelltVonId], references: [id])
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

// ---------- Aufgaben ----------

model Aufgabe {
  id              String       @id @default(cuid())
  titel           String
  faelligkeit     DateTime?
  personId        String? // null = familienweit
  person          Person?      @relation("AufgabePerson", fields: [personId], references: [id])
  erledigt        Boolean      @default(false)
  seriesId        String?
  wiederholung    Wiederholung @default(KEINE)
  wiederholungBis DateTime?
  erstelltVonId   String
  erstelltVon     Person       @relation("AufgabeErsteller", fields: [erstelltVonId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ---------- Einkaufsliste ----------

model EinkaufsKategorie {
  id          String            @id @default(cuid())
  name        String            @unique
  reihenfolge Int               @default(0)
  artikel     EinkaufsArtikel[]
}

model EinkaufsArtikel {
  id           String             @id @default(cuid())
  name         String
  menge        String?
  notiz        String? // z.B. "Körnerbrot" bei Artikel "Brot" (Fix-Batch 33 Nachtrag)
  kategorieId  String?
  kategorie    EinkaufsKategorie? @relation(fields: [kategorieId], references: [id])
  erledigt     Boolean            @default(false)
  quelle       String             @default("manuell") // "manuell" | "essensplan" | "wunsch"
  vonWunschId  String?
  // "noch nicht zugesagt" (Fix-Batch 24): Zutaten aus dem Essensplan landen zunächst hier
  // mit bestaetigt=false und müssen auf der Einkaufsliste erst geprüft/angepasst/bestätigt
  // werden, bevor sie als normaler Artikel zählen. Alle anderen Wege (manuell, Wunsch,
  // Extra-Rezept) legen weiterhin direkt bestätigte Artikel an (Default true).
  bestaetigt   Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  essensplanHerkuenfte EssensplanHerkunft[]
  quellen              ArtikelQuelle[]
}

// Quellen-Aufschlüsselung je Artikel (Fahrplan §3, Batch 2) — für manuelle
// Hinzufügungen und genehmigte Kind-Wünsche. Essensplan-Herkünfte werden nicht
// hier zusätzlich gespeichert, sondern aus `EssensplanHerkunft` mitgelesen
// (keine doppelte Datenhaltung).
model ArtikelQuelle {
  id           String          @id @default(cuid())
  artikelId    String
  artikel      EinkaufsArtikel @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  beschreibung String // z.B. "Manuell hinzugefügt" oder "Wunsch von Emma"
  menge        String?
  createdAt    DateTime        @default(now())
}

// Vorschlagsliste häufig gekaufter Artikel (Fahrplan §3, Batch 2) — Dämpfungsfaktor
// für weggewischte Vorschläge, per Reset-Button wieder auf null setzbar.
model VorschlagDismiss {
  id     String @id @default(cuid())
  name   String @unique // kleingeschriebener, getrimmter Artikelname
  anzahl Int    @default(1)
}

enum WunschStatus {
  OFFEN
  GENEHMIGT
  ABGELEHNT
}

model EinkaufsWunsch {
  id             String       @id @default(cuid())
  artikelName    String
  menge          String?
  kindId         String
  kind           Person       @relation(fields: [kindId], references: [id])
  status         WunschStatus @default(OFFEN)
  entschiedenAm  DateTime?
  notiz          String?
  createdAt      DateTime     @default(now())
}

// ---------- Schule & Noten & Taschengeld ----------

model Fach {
  id           String            @id @default(cuid())
  name         String
  kindId       String
  kind         Person            @relation(fields: [kindId], references: [id])
  noten        Note[]
  gewichtungen NotenGewichtung[]
  schulEintraege SchulEintrag[]

  @@unique([kindId, name])
}

enum NoteArt {
  KLASSENARBEIT
  HAUSAUFGABEN_KONTROLLE
  EPOCHALNOTE
}

enum NoteStatus {
  OFFEN
  GENEHMIGT
  ABGELEHNT
}

// Voreinstellung für die Gewichtung, mit der neue Noten eines Fachs/einer Art
// automatisch angelegt werden (Frage 21). Pro Kind + Fach + Art einzeln einstellbar,
// mit Übertragen-Funktion auf andere Fächer/Kinder in der UI.
model NotenGewichtung {
  id         String  @id @default(cuid())
  kindId     String
  kind       Person  @relation(fields: [kindId], references: [id])
  fachId     String
  fach       Fach    @relation(fields: [fachId], references: [id])
  art        NoteArt
  gewichtung Float   @default(1)

  @@unique([kindId, fachId, art])
}

model Note {
  id            String     @id @default(cuid())
  kindId        String
  kind          Person     @relation(fields: [kindId], references: [id])
  fachId        String
  fach          Fach       @relation(fields: [fachId], references: [id])
  art           NoteArt
  note          Int
  datum         DateTime
  notiz         String?
  gewichtung    Float      @default(1)
  fotoBase64    String?    @db.Text
  status        NoteStatus @default(OFFEN)
  eingetragenVonId String  // Kind selbst oder Elternteil
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  taschengeld   TaschengeldTransaktion[]
}

enum TransaktionsTyp {
  GUTSCHRIFT
  AUSZAHLUNG
}

model TaschengeldTransaktion {
  id            String          @id @default(cuid())
  kindId        String
  kind          Person          @relation(fields: [kindId], references: [id])
  betrag        Float // Auszahlungen negativ oder typ beachten
  typ           TransaktionsTyp
  grund         String?
  noteId        String?
  note          Note?           @relation(fields: [noteId], references: [id])
  erstelltVonId String
  createdAt     DateTime        @default(now())
}

model Sparziel {
  id          String @id @default(cuid())
  kindId      String @unique
  kind        Person @relation(fields: [kindId], references: [id])
  bezeichnung String
  zielbetrag  Float
}

model SchulEintrag {
  id           String   @id @default(cuid())
  titel        String // Fix-Batch 30: enthält jetzt das "Thema" (was früher fälschlich als Titel bezeichnet wurde)
  fachName     String? // veraltet seit Fix-Batch 30 (nur noch für alte Einträge ohne fachId) — neue Einträge nutzen fachId
  fachId       String?
  fach         Fach?    @relation(fields: [fachId], references: [id])
  art          NoteArt
  datum        DateTime
  personId     String
  person       Person   @relation("SchulEintragPerson", fields: [personId], references: [id])
  createdAt    DateTime @default(now())
}

// ---------- Dienstplan ----------

model DienstDefinition {
  id            String @id @default(cuid())
  schichtNummer Int // 1, 2 oder 3
  reihenfolge   Int
  bezeichnung   String
  beschreibung  String?
}

model DienstZuweisung {
  id            String   @id @default(cuid())
  wocheStart    DateTime // Montag der jeweiligen Woche
  schichtNummer Int
  kindId        String
  kind          Person   @relation(fields: [kindId], references: [id])

  @@unique([wocheStart, schichtNummer])
}

enum DienstTauschModus {
  ABGEBEN // vonKind gibt den Dienst ab, mitKind übernimmt zusätzlich zum eigenen (einseitig)
  TAUSCH // vonKind und mitKind tauschen ihre Dienste gegenseitig (beidseitig)
}

model DienstTausch {
  id            String            @id @default(cuid())
  wocheStart    DateTime
  tag           DateTime? // null = ganze Woche
  modus         DienstTauschModus @default(ABGEBEN)
  vonKindId     String
  vonKind       Person            @relation("DienstTauschVon", fields: [vonKindId], references: [id])
  mitKindId     String
  mitKind       Person            @relation("DienstTauschMit", fields: [mitKindId], references: [id])
  aufgehoben    Boolean           @default(false)
  erstelltVonId String
  createdAt     DateTime          @default(now())
}

model BadZuweisung {
  id         String   @id @default(cuid())
  wocheStart DateTime
  zeitpunkt  String // "morgens" | "abends"
  position   Int
  kindId     String
  kind       Person   @relation(fields: [kindId], references: [id])

  @@unique([wocheStart, zeitpunkt, position])
}

// ---------- Dienstplan-Nachschlagewerk & Zusatzaufgaben (Fahrplan §3, Batch 4) ----------
// Bewusst frei durch Eltern editierbar statt mit vorgefertigtem Text — der reale Wortlaut
// aus Florians Word-Dokument "Schichtsystem" liegt Claude in dieser Sitzung nicht vor.

model Tagesroutine {
  id          String @id @default(cuid())
  kategorie   String // z.B. "Morgens", "Vor der Schule", "Nach der Schule", "Lernregel", "Abends"
  reihenfolge Int    @default(0)
  text        String
}

model Koerperpflegetag {
  id        String @id @default(cuid())
  wochentag Int    @unique // 1 = Montag ... 7 = Sonntag
  text      String
}

// ---------- Rezepte & Essensplan ----------

model Rezept {
  id        String   @id @default(cuid())
  name      String
  zutaten   String // eine Zutat pro Zeile, "Menge Einheit Name"
  zubereitung String?
  // Für wie viele Portionen die Mengenangaben in "zutaten" geschrieben sind (Kochbücher/
  // Internet-Rezepte geben oft z.B. "für 1 Portion" oder "für 4 Personen" an, nicht für
  // die ganze Familie) — Grundlage für die automatische Skalierung auf die Esser-Anzahl
  // (Fix-Batch 22). Default 6 entspricht dem bisherigen impliziten Verhalten (alle Rezepte
  // gelten als für die ganze 6-köpfige Familie geschrieben).
  portionenBasis Int @default(6)
  createdAt DateTime @default(now())

  planEintraege  EssensplanEintrag[]
  ausblendungen  RezeptAusblendung[]
}

model EssensplanEintrag {
  id          String   @id @default(cuid())
  wocheStart  DateTime // Samstag der jeweiligen Woche
  tag         DateTime
  rezeptId    String
  rezept      Rezept   @relation(fields: [rezeptId], references: [id])
  esserIds    String[] @default([])
  esserFaktor Float    @default(1)
  extraPortionen Float @default(0) // z.B. Gäste an dem Tag, zusätzlich zu den ausgewählten Essern
  gelockt     Boolean  @default(false)

  herkuenfte  EssensplanHerkunft[]
}

// Blendet ein Rezept aus den Vorschlägen für eine einzelne Woche aus (Fahrplan §3,
// Batch 5) — bewusst pro Woche statt global, damit es später wieder vorgeschlagen wird.
model RezeptAusblendung {
  id         String   @id @default(cuid())
  rezeptId   String
  rezept     Rezept   @relation(fields: [rezeptId], references: [id], onDelete: Cascade)
  wocheStart DateTime

  @@unique([rezeptId, wocheStart])
}

// Merkt sich, welcher Essensplan-Tag welche (skalierte) Menge zu welchem
// Einkaufslisten-Artikel beigetragen hat — Grundlage für den Entfernen/Behalten-Dialog,
// wenn ein Gericht in einer bereits gelockten Woche geändert wird (Fahrplan §3).
// Bekannte, bewusst in Kauf genommene Einschränkung: Wird beim "Entfernen" die Menge
// neu berechnet, fließen nur die noch bekannten Essensplan-Herkünfte ein — ein zufällig
// in denselben Artikel gemischter manueller Anteil (gleicher Name, andere Quelle) wird
// dabei nicht separat zurückgerechnet.
model EssensplanHerkunft {
  id        String            @id @default(cuid())
  artikelId String
  artikel   EinkaufsArtikel   @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  eintragId String
  eintrag   EssensplanEintrag @relation(fields: [eintragId], references: [id], onDelete: Cascade)
  menge     String?
  createdAt DateTime          @default(now())

  @@unique([artikelId, eintragId])
}

// ---------- Push-Benachrichtigungen (Fragenkatalog Frage 33, Batch 8) ----------
// Pro Gerät/Browser eine eigene Subscription (nicht pro Person insgesamt) — eine Person
// kann mehrere Geräte aktiviert haben, alle bekommen dieselbe Benachrichtigung.

model PushSubscription {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ---------- Ticketsystem für Fehlermeldungen/Verbesserungsvorschläge (Fix-Batch 26) ----------
// Jede Person kann per Spracheingabe oder Text ein Ticket einreichen (Einstellungen →
// "Fehler melden"); Eltern (nicht auf Florian technisch beschränkbar, da die App keine
// Sonderrechte zwischen einzelnen Elternteilen kennt, siehe Fragenkatalog) genehmigen/
// lehnen ab/setzen auf "in Umsetzung". "Umgesetzt" wird nicht automatisch erkannt, sondern
// von Claude Code beim tatsächlichen Umsetzen eines genehmigten Tickets manuell gesetzt
// (Teil des normalen FAHRPLAN.md-Workflows dieses Projekts).
enum TicketStatus {
  EINGEREICHT
  GENEHMIGT
  ABGELEHNT
  IN_UMSETZUNG
  UMGESETZT
}

model Ticket {
  id            String       @id @default(cuid())
  titel         String
  beschreibung  String
  status        TicketStatus @default(EINGEREICHT)
  begruendung   String? // optionale Begründung der Eltern (v.a. bei Ablehnung)
  fotoBase64    String? // optionales Foto zum Ticket (Fix-Batch 35, z.B. Screenshot des Fehlers)
  erstelltVonId String
  erstelltVon   Person       @relation(fields: [erstelltVonId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ---------- Schulferien (Fix-Batch 27) ----------
// Statische Referenzdaten (aus src/lib/schulferienDaten.ts, jährlich per Deploy neu
// synchronisiert — analog dem Dienstkatalog-Vorlage-Mechanismus), nicht in der App editierbar.
model Schulferien {
  id         String   @id @default(cuid())
  bundesland String
  schuljahr  String // z.B. "2026/2027"
  typ        String // HERBST | WEIHNACHTEN | WINTER | OSTERN | PFINGSTEN | SOMMER
  start      DateTime
  ende       DateTime

  @@unique([bundesland, schuljahr, typ])
}
