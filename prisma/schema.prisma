// Familientisch — Datenmodell (Grundgerüst)
// Deckt alle in fahrplan_v2.md / fragenkatalog.md entschiedenen Bereiche ab.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Multi-Tenant: Familie ----------
// Fix-Batch 132 (Florians Wunsch: "eine App für alle Familien"): mehrere Familien nutzen ab
// jetzt dieselbe App-Instanz, datenmäßig strikt getrennt über familieId. Florians eigene
// Bestandsfamilie bekommt beim Deploy automatisch slug=null und bleibt dadurch auf der
// bisherigen Root-Login-URL erreichbar (siehe login/actions.ts) — für ihn ändert sich im
// Alltag nichts. Neue Familien bekommen einen slug und loggen sich über /f/<slug> ein.
model Familie {
  id              String   @id @default(cuid())
  name            String
  slug            String?  @unique
  // Pro-Familie ein-/ausblendbare Bereiche (Florians Wunsch: "z.B. das mit den Diensten, ich
  // denke viele haben das gar nicht") — steuert, welche Reiter in Navigation/Tutorial erscheinen.
  dienstplanAktiv Boolean  @default(true)
  schuleAktiv     Boolean  @default(true)
  // Pro-Familie individuell einstellbare externe Verlinkung (Florians Beispiel: "wie bei uns
  // mit der THG-App") — erscheint im Dashboard nur, wenn gesetzt.
  thgUrl          String?
  createdAt       DateTime @default(now())

  personen                  Person[]
  termine                   Termin[]
  aufgaben                  Aufgabe[]
  einkaufsKategorien        EinkaufsKategorie[]
  einkaufsArtikel           EinkaufsArtikel[]
  einkaufsWuensche          EinkaufsWunsch[]
  vorschlagDismisses        VorschlagDismiss[]
  gelernteArtikelIcons      GelernteArtikelIcons[]
  saisonVorschlaege         SaisonVorschlag[]
  gelernteArtikelKategorien GelernteArtikelKategorie[]
  faecher                   Fach[]
  notenGewichtungen         NotenGewichtung[]
  noten                     Note[]
  taschengeldTransaktionen  TaschengeldTransaktion[]
  sparziele                 Sparziel[]
  schulEintraege            SchulEintrag[]
  dienstDefinitionen        DienstDefinition[]
  dienstZuweisungen         DienstZuweisung[]
  dienstTausche             DienstTausch[]
  badZuweisungen            BadZuweisung[]
  dauerhafteZuordnungen     DauerhafteZuordnung[]
  tagesroutinen             Tagesroutine[]
  koerperpflegetage         Koerperpflegetag[]
  rezepte                   Rezept[]
  essensplanEintraege       EssensplanEintrag[]
  extraMahlzeiten           ExtraMahlzeit[]
  tickets                   Ticket[]
  hausprobleme              Hausproblem[]
}

// ---------- Personen & Login ----------

enum Rolle {
  ELTERN
  KIND
  KIND_OHNE_ZUGANG // z.B. Ayla: verwaltet, aber kein eigener Login
}

model Person {
  id                       String    @id @default(cuid())
  // Fix-Batch 132 (Multi-Tenant): nullable, damit der Schema-Push nie Bestandsdaten
  // gefährdet — seed.ts weist allen bereits existierenden Personen automatisch Florians
  // Familie zu, ohne je eine Zeile zu löschen.
  familieId                String?
  familie                  Familie?  @relation(fields: [familieId], references: [id])
  name                     String
  rolle                    Rolle
  farbe                    String    @default("#8a7a63")
  pinHash                  String? // nur gesetzt, wenn rolle Login erlaubt
  // Fix-Batch 131 (Florians Wunsch, nach dem Account-Vorfall): Brute-Force-Schutz für die
  // 4-stellige PIN (nur 10.000 Kombinationen) — nach ein paar Fehlversuchen kurze Sperre statt
  // beliebig oft raten zu dürfen. Bei jedem erfolgreichen Login zurückgesetzt.
  pinFehlversuche          Int       @default(0)
  pinGesperrtBis           DateTime?
  // Fix-Batch 131: erzwingt eine PIN-Änderung, solange noch die Standard-PIN "0000" aus dem
  // Seed-Skript aktiv ist — verhindert, dass eine leicht erratbare Standard-PIN unbemerkt
  // dauerhaft aktiv bleibt. Wird beim Ändern der eigenen PIN automatisch wieder gelöscht.
  pinAendernErforderlich   Boolean   @default(false)
  aktiv                    Boolean   @default(true)
  reihenfolge              Int       @default(0)
  // Portionsgröße für den Essensplan-Skalierungsrechner (Fix-Batch 23) — vorher fest im
  // Code hinterlegt (Flo 1.5, Ayla 0.5, Rest 1), jetzt in den Einstellungen editierbar.
  portionsGewicht          Float     @default(1)
  // Für den Ferien-Countdown und die Schuljahr-Zuordnung (Fix-Batch 27) — nur für Kinder
  // relevant, in den Einstellungen von jedem Kind selbst wählbar.
  bundesland               String?
  klassenstufe             Int?
  klasse                   String? // z.B. "5a"
  // Geburtstag (Fix-Batch 30) — erscheint dann automatisch im Kalender ALLER Familienmitglieder.
  geburtsdatum             DateTime?
  // Fix-Batch 62: verhindert, dass die 7-Tage-vorher-Push-Erinnerung im selben Jahr mehrfach
  // rausgeht — geprüft/gesetzt bei jedem Dashboard-Aufruf (siehe dashboard/actions.ts).
  geburtstagErinnerungJahr Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  sessions              Session[]
  termineErstellt       Termin[]                 @relation("TerminErsteller")
  termine               Termin[]                 @relation("TerminPerson")
  terminHistorie        AenderungsLog[]          @relation("AenderungVon")
  aufgaben              Aufgabe[]                @relation("AufgabePerson")
  aufgabenErstellt      Aufgabe[]                @relation("AufgabeErsteller")
  einkaufsWuensche      EinkaufsWunsch[]
  faecher               Fach[]
  noten                 Note[]
  notenGewichtungen     NotenGewichtung[]
  taschengeld           TaschengeldTransaktion[]
  sparziel              Sparziel?
  dienstZuweisungen     DienstZuweisung[]
  dienstTauscheVon      DienstTausch[]           @relation("DienstTauschVon")
  dienstTauscheMit      DienstTausch[]           @relation("DienstTauschMit")
  badZuweisungen        BadZuweisung[]
  pushSubscriptions     PushSubscription[]
  schulEintraege        SchulEintrag[]           @relation("SchulEintragPerson")
  tickets               Ticket[]
  dauerhafteZuordnungen DauerhafteZuordnung[]
  hausprobleme          Hausproblem[]
}

model Session {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ---------- Generische Änderungshistorie ----------
// Umfang laut Entscheidung (Runde 5): Noten, Taschengeld, Termine, Aufgaben,
// Dienst-Tausch, Einkaufs-Wünsche — NICHT die laufende Einkaufslisten-Pflege selbst.

enum EntityTyp {
  TERMIN
  AUFGABE
  NOTE
  TASCHENGELD
  DIENST_TAUSCH
  EINKAUFS_WUNSCH
}

model AenderungsLog {
  id             String    @id @default(cuid())
  entityTyp      EntityTyp
  entityId       String
  aktion         String // z.B. "erstellt", "geaendert", "geloescht", "genehmigt", "abgelehnt"
  feld           String? // bei "geaendert": welches Feld
  alterWert      String?
  neuerWert      String?
  geaendertVonId String
  geaendertVon   Person    @relation("AenderungVon", fields: [geaendertVonId], references: [id])
  zeitpunkt      DateTime  @default(now())

  @@index([entityTyp, entityId])
}

// ---------- Kalender ----------

enum TerminKategorie {
  TERMIN
  HOBBY
  AUSFLUG
  SCHULE
  DIENST
}

enum Wiederholung {
  KEINE
  TAEGLICH
  WERKTAEGLICH // Mo-Fr (Fix-Batch 30)
  WOECHENTLICH
  ZWEIWOECHENTLICH
  MONATLICH
  ALLE_3_MONATE // Fix-Batch 30
  JAEHRLICH // Fix-Batch 30
}

model Termin {
  id                 String          @id @default(cuid())
  // Fix-Batch 132: bewusst direkt hier (nicht nur über personId ableitbar), weil ein
  // familienweiter Termin personId=null hat und sonst keine Familie zuzuordnen wäre.
  familieId          String?
  familie            Familie?        @relation(fields: [familieId], references: [id])
  titel              String
  // Fix-Batch 122 (Florians Wunsch): freies Notizfeld statt der entfernten strukturierten
  // Packliste (Fix-Batch 92) — z. B. "Sonnencreme und Röntgenbilder mitnehmen", ohne eigene
  // Checkliste. War vorher als ungenutztes `beschreibung`-Feld angelegt, jetzt umbenannt und
  // tatsächlich verdrahtet.
  notiz              String?
  start              DateTime
  ende               DateTime?
  ganztaegig         Boolean         @default(false)
  kategorie          TerminKategorie @default(TERMIN)
  personId           String? // null = familienweit
  person             Person?         @relation("TerminPerson", fields: [personId], references: [id])
  seriesId           String?
  // Gemeinsame ID über alle Personen-Zeilen EINES Anlege-Vorgangs (Fix-Batch 30) — damit
  // ein Termin für mehrere Personen im Eltern-Kalender als EIN Eintrag mit allen Personen
  // angezeigt werden kann statt einmal pro Person dupliziert.
  gruppeId           String?
  wiederholung       Wiederholung    @default(KEINE)
  wiederholungBis    DateTime?
  erinnerungGesendet Boolean         @default(false)
  // Fix-Batch 89 (Florians Wunsch): Anhänge (Bild oder PDF) je Termin, als Base64-Daten-URLs
  // (analog Ticket.fotos/Hausproblem.fotos) — sichtbar nur für die Zielperson(en) und
  // den/die Ersteller:in, siehe listTermine() in actions.ts.
  anhaenge           String[]        @default([])
  erstelltVonId      String
  erstelltVon        Person          @relation("TerminErsteller", fields: [erstelltVonId], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// ---------- Aufgaben ----------

model Aufgabe {
  id              String       @id @default(cuid())
  // Fix-Batch 132: siehe Kommentar bei Termin.familieId (familienweite Aufgaben haben
  // ebenfalls personId=null).
  familieId       String?
  familie         Familie?     @relation(fields: [familieId], references: [id])
  titel           String
  faelligkeit     DateTime?
  personId        String? // null = familienweit
  person          Person?      @relation("AufgabePerson", fields: [personId], references: [id])
  erledigt        Boolean      @default(false)
  seriesId        String?
  wiederholung    Wiederholung @default(KEINE)
  wiederholungBis DateTime?
  erstelltVonId   String
  erstelltVon     Person       @relation("AufgabeErsteller", fields: [erstelltVonId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ---------- Einkaufsliste ----------

model EinkaufsKategorie {
  id          String            @id @default(cuid())
  // Fix-Batch 132: Spalte vorbereitet, aber die @unique-Einschränkung bewusst NOCH auf
  // "name" allein belassen (nicht auf [familieId, name] umgestellt) — eine echte
  // Mehrfamilien-Trennung inkl. Query-Scoping folgt erst in einem eigenen Bereich-Batch,
  // bis dahin soll dieses Fundament keine bestehende Abfrage in actions.ts brechen.
  familieId   String?
  familie     Familie?          @relation(fields: [familieId], references: [id])
  name        String            @unique
  reihenfolge Int               @default(0)
  artikel     EinkaufsArtikel[]
}

model EinkaufsArtikel {
  id           String             @id @default(cuid())
  familieId    String?
  familie      Familie?           @relation(fields: [familieId], references: [id])
  name         String
  menge        String?
  notiz        String? // z.B. "Körnerbrot" bei Artikel "Brot" (Fix-Batch 33 Nachtrag)
  iconOverride String? // manuell gewähltes Icon statt der Automatik (Fix-Batch 35 Nachtrag)
  kategorieId  String?
  kategorie    EinkaufsKategorie? @relation(fields: [kategorieId], references: [id])
  erledigt     Boolean            @default(false)
  quelle       String             @default("manuell") // "manuell" | "essensplan" | "wunsch"
  vonWunschId  String?
  // "noch nicht zugesagt" (Fix-Batch 24): Zutaten aus dem Essensplan landen zunächst hier
  // mit bestaetigt=false und müssen auf der Einkaufsliste erst geprüft/angepasst/bestätigt
  // werden, bevor sie als normaler Artikel zählen. Alle anderen Wege (manuell, Wunsch,
  // Extra-Rezept) legen weiterhin direkt bestätigte Artikel an (Default true).
  bestaetigt   Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  essensplanHerkuenfte    EssensplanHerkunft[]
  extraMahlzeitHerkuenfte ExtraMahlzeitHerkunft[]
  quellen                 ArtikelQuelle[]
}

// Quellen-Aufschlüsselung je Artikel (Fahrplan §3, Batch 2) — für manuelle
// Hinzufügungen und genehmigte Kind-Wünsche. Essensplan-Herkünfte werden nicht
// hier zusätzlich gespeichert, sondern aus `EssensplanHerkunft` mitgelesen
// (keine doppelte Datenhaltung).
model ArtikelQuelle {
  id           String          @id @default(cuid())
  artikelId    String
  artikel      EinkaufsArtikel @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  beschreibung String // z.B. "Manuell hinzugefügt" oder "Wunsch von Emma"
  menge        String?
  createdAt    DateTime        @default(now())
}

// Vorschlagsliste häufig gekaufter Artikel (Fahrplan §3, Batch 2) — Dämpfungsfaktor
// für weggewischte Vorschläge, per Reset-Button wieder auf null setzbar.
model VorschlagDismiss {
  id        String   @id @default(cuid())
  // Fix-Batch 132: siehe Kommentar bei EinkaufsKategorie.familieId — Unique bewusst noch
  // nicht auf familieId umgestellt, folgt erst mit dem Query-Scoping-Batch.
  familieId String?
  familie   Familie? @relation(fields: [familieId], references: [id])
  name      String   @unique // kleingeschriebener, getrimmter Artikelname
  anzahl    Int      @default(1)
}

// Fix-Batch 63 (Florians KI-Vorschlag "Icon-Lerndatenbank"): wenn jemand ein Icon manuell
// korrigiert (iconOverride), merkt sich die App das global für diesen Artikelnamen, damit
// künftige neue Artikel mit demselben Namen automatisch das korrigierte Icon bekommen statt
// wieder auf die (ggf. falsche) Stichwort-Erkennung zurückzufallen.
model GelernteArtikelIcons {
  id        String   @id @default(cuid())
  familieId String?
  familie   Familie? @relation(fields: [familieId], references: [id])
  name      String   @unique // kleingeschriebener, getrimmter Artikelname
  icon      String
  updatedAt DateTime @updatedAt
}

// Fix-Batch 64: merkt sich zuletzt vorgeschlagene saisonale Rezeptnamen, damit die KI nicht
// wiederholt dasselbe Gericht vorschlägt (Florians Einwand: "nicht immer Kürbis").
model SaisonVorschlag {
  id        String   @id @default(cuid())
  familieId String?
  familie   Familie? @relation(fields: [familieId], references: [id])
  saison    String
  name      String
  createdAt DateTime @default(now())
}

// Fix-Batch 71 (Florians Wunsch: "die KI muss ständig dazulernen ... egal aus welcher
// Quelle die Eingabe kommt") — Gegenstück zu GelernteArtikelIcons, aber für die Kategorie:
// sobald eine Kategorie manuell korrigiert wird, wird das global für diesen Artikelnamen
// gemerkt. Speichert bewusst den KATEGORIE-NAMEN (nicht die id) — Kategorien können
// umbenannt/gelöscht werden, ein Name lässt sich beim Lesen sicher nachschlagen, eine
// veraltete id könnte dagegen eine Fremdschlüssel-Verletzung beim Anlegen auslösen.
model GelernteArtikelKategorie {
  id            String   @id @default(cuid())
  familieId     String?
  familie       Familie? @relation(fields: [familieId], references: [id])
  name          String   @unique // kleingeschriebener, getrimmter Artikelname
  kategorieName String
  updatedAt     DateTime @updatedAt
}

enum WunschStatus {
  OFFEN
  GENEHMIGT
  ABGELEHNT
}

model EinkaufsWunsch {
  id            String       @id @default(cuid())
  familieId     String?
  familie       Familie?     @relation(fields: [familieId], references: [id])
  artikelName   String
  menge         String?
  kindId        String
  kind          Person       @relation(fields: [kindId], references: [id])
  status        WunschStatus @default(OFFEN)
  entschiedenAm DateTime?
  notiz         String?
  createdAt     DateTime     @default(now())
}

// ---------- Schule & Noten & Taschengeld ----------

model Fach {
  id             String            @id @default(cuid())
  familieId      String?
  familie        Familie?          @relation(fields: [familieId], references: [id])
  name           String
  kindId         String
  kind           Person            @relation(fields: [kindId], references: [id])
  noten          Note[]
  gewichtungen   NotenGewichtung[]
  schulEintraege SchulEintrag[]

  @@unique([kindId, name])
}

enum NoteArt {
  KLASSENARBEIT
  HAUSAUFGABEN_KONTROLLE
  EPOCHALNOTE
}

enum NoteStatus {
  OFFEN
  GENEHMIGT
  ABGELEHNT
}

// Fix-Batch 120: rein informative Tendenz (z. B. mündliche Note "zwischen" zwei Noten) —
// bewusst kein Einfluss auf Notenschnitt/Taschengeld, siehe Kommentar am Note-Modell.
enum NotenTendenz {
  PLUS
  MINUS
}

// Voreinstellung für die Gewichtung, mit der neue Noten eines Fachs/einer Art
// automatisch angelegt werden (Frage 21). Pro Kind + Fach + Art einzeln einstellbar,
// mit Übertragen-Funktion auf andere Fächer/Kinder in der UI.
model NotenGewichtung {
  id         String   @id @default(cuid())
  familieId  String?
  familie    Familie? @relation(fields: [familieId], references: [id])
  kindId     String
  kind       Person   @relation(fields: [kindId], references: [id])
  fachId     String
  fach       Fach     @relation(fields: [fachId], references: [id])
  art        NoteArt
  gewichtung Float    @default(1)

  @@unique([kindId, fachId, art])
}

model Note {
  id               String        @id @default(cuid())
  familieId        String?
  familie          Familie?      @relation(fields: [familieId], references: [id])
  kindId           String
  kind             Person        @relation(fields: [kindId], references: [id])
  fachId           String
  fach             Fach          @relation(fields: [fachId], references: [id])
  art              NoteArt
  note             Int
  // Fix-Batch 120 (Florians Wunsch): manche Noten stehen "zwischen" zwei ganzen Noten
  // (z. B. mündlich) — Tendenz +/- wird rein informativ mitgeführt, fließt bewusst NICHT in
  // den Notenschnitt oder die Taschengeld-Berechnung ein (beide rechnen weiterhin nur mit
  // `note`), dient nur der Auszählung "wie oft stand das Kind zwischen zwei Noten" am
  // Schuljahresende.
  tendenz          NotenTendenz?
  datum            DateTime
  notiz            String?
  gewichtung       Float         @default(1)
  fotoBase64       String?       @db.Text
  status           NoteStatus    @default(OFFEN)
  eingetragenVonId String // Kind selbst oder Elternteil
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  taschengeld TaschengeldTransaktion[]
}

enum TransaktionsTyp {
  GUTSCHRIFT
  AUSZAHLUNG
}

model TaschengeldTransaktion {
  id            String          @id @default(cuid())
  familieId     String?
  familie       Familie?        @relation(fields: [familieId], references: [id])
  kindId        String
  kind          Person          @relation(fields: [kindId], references: [id])
  betrag        Float // Auszahlungen negativ oder typ beachten
  typ           TransaktionsTyp
  grund         String?
  noteId        String?
  note          Note?           @relation(fields: [noteId], references: [id])
  erstelltVonId String
  createdAt     DateTime        @default(now())
}

model Sparziel {
  id          String   @id @default(cuid())
  familieId   String?
  familie     Familie? @relation(fields: [familieId], references: [id])
  kindId      String   @unique
  kind        Person   @relation(fields: [kindId], references: [id])
  bezeichnung String
  zielbetrag  Float
}

model SchulEintrag {
  id               String   @id @default(cuid())
  familieId        String?
  familie          Familie? @relation(fields: [familieId], references: [id])
  titel            String // Fix-Batch 30: enthält jetzt das "Thema" (was früher fälschlich als Titel bezeichnet wurde)
  fachName         String? // veraltet seit Fix-Batch 30 (nur noch für alte Einträge ohne fachId) — neue Einträge nutzen fachId
  fachId           String?
  fach             Fach?    @relation(fields: [fachId], references: [id])
  art              NoteArt
  datum            DateTime
  personId         String
  person           Person   @relation("SchulEintragPerson", fields: [personId], references: [id])
  createdAt        DateTime @default(now())
  // Fix-Batch 62: verhindert mehrfache Lerntipp-Push-Erinnerungen für denselben Eintrag —
  // geprüft/gesetzt bei jedem Dashboard-Aufruf (siehe dashboard/actions.ts).
  lerntippGesendet Boolean  @default(false)
}

// ---------- Dienstplan ----------

model DienstDefinition {
  id            String   @id @default(cuid())
  familieId     String?
  familie       Familie? @relation(fields: [familieId], references: [id])
  schichtNummer Int // 1, 2 oder 3
  reihenfolge   Int
  bezeichnung   String
  beschreibung  String?
}

model DienstZuweisung {
  id            String   @id @default(cuid())
  familieId     String?
  familie       Familie? @relation(fields: [familieId], references: [id])
  wocheStart    DateTime // Montag der jeweiligen Woche
  schichtNummer Int
  kindId        String
  kind          Person   @relation(fields: [kindId], references: [id])

  @@unique([wocheStart, schichtNummer])
}

enum DienstTauschModus {
  ABGEBEN // vonKind gibt den Dienst ab, mitKind übernimmt zusätzlich zum eigenen (einseitig)
  TAUSCH // vonKind und mitKind tauschen ihre Dienste gegenseitig (beidseitig)
}

model DienstTausch {
  id            String            @id @default(cuid())
  familieId     String?
  familie       Familie?          @relation(fields: [familieId], references: [id])
  wocheStart    DateTime
  tag           DateTime? // null = ganze Woche
  modus         DienstTauschModus @default(ABGEBEN)
  vonKindId     String
  vonKind       Person            @relation("DienstTauschVon", fields: [vonKindId], references: [id])
  mitKindId     String
  mitKind       Person            @relation("DienstTauschMit", fields: [mitKindId], references: [id])
  aufgehoben    Boolean           @default(false)
  erstelltVonId String
  createdAt     DateTime          @default(now())
}

model BadZuweisung {
  id         String   @id @default(cuid())
  familieId  String?
  familie    Familie? @relation(fields: [familieId], references: [id])
  wocheStart DateTime
  zeitpunkt  String // "morgens" | "abends"
  position   Int
  kindId     String
  kind       Person   @relation(fields: [kindId], references: [id])

  @@unique([wocheStart, zeitpunkt, position])
}

// Dauerhafte Tausche (Fix-Batch 35, Florians Wunsch) — im Unterschied zu DienstTausch/
// BadZuweisung-Direktänderung (immer nur für EINE Woche bzw. EINEN Tag) legt das hier fest,
// wer einen Slot ab sofort UNBEFRISTET innehat (überschreibt die algorithmische Rotation aus
// lib/dienstplan.ts für neu erzeugte Wochen; bereits erzeugte aktuelle/zukünftige Wochen werden
// beim Setzen einmalig nachträglich mit-aktualisiert, siehe setzeDauerhafteZuordnungIntern).
enum DauerhaftArt {
  DIENST
  BAD_MORGENS
  BAD_ABENDS
}

model DauerhafteZuordnung {
  id        String       @id @default(cuid())
  familieId String?
  familie   Familie?     @relation(fields: [familieId], references: [id])
  art       DauerhaftArt
  slot      Int // schichtNummer (1-3) bei DIENST, position (1-3) bei BAD_*
  kindId    String
  kind      Person       @relation(fields: [kindId], references: [id])
  updatedAt DateTime     @updatedAt

  @@unique([art, slot])
}

// ---------- Dienstplan-Nachschlagewerk & Zusatzaufgaben (Fahrplan §3, Batch 4) ----------
// Bewusst frei durch Eltern editierbar statt mit vorgefertigtem Text — der reale Wortlaut
// aus Florians Word-Dokument "Schichtsystem" liegt Claude in dieser Sitzung nicht vor.

model Tagesroutine {
  id          String   @id @default(cuid())
  familieId   String?
  familie     Familie? @relation(fields: [familieId], references: [id])
  kategorie   String // z.B. "Morgens", "Vor der Schule", "Nach der Schule", "Lernregel", "Abends"
  reihenfolge Int      @default(0)
  text        String
}

model Koerperpflegetag {
  id        String   @id @default(cuid())
  familieId String?
  familie   Familie? @relation(fields: [familieId], references: [id])
  wochentag Int      @unique // 1 = Montag ... 7 = Sonntag
  text      String
}

// ---------- Rezepte & Essensplan ----------

model Rezept {
  id             String   @id @default(cuid())
  familieId      String?
  familie        Familie? @relation(fields: [familieId], references: [id])
  name           String
  zutaten        String // eine Zutat pro Zeile, "Menge Einheit Name"
  zubereitung    String?
  // Für wie viele Portionen die Mengenangaben in "zutaten" geschrieben sind (Kochbücher/
  // Internet-Rezepte geben oft z.B. "für 1 Portion" oder "für 4 Personen" an, nicht für
  // die ganze Familie) — Grundlage für die automatische Skalierung auf die Esser-Anzahl
  // (Fix-Batch 22). Default 6 entspricht dem bisherigen impliziten Verhalten (alle Rezepte
  // gelten als für die ganze 6-köpfige Familie geschrieben).
  portionenBasis Int      @default(6)
  // Fix-Batch 75 (Florians Wunsch): Rezeptkategorie (Hauptgang/Vorspeise/Suppe/Dessert/
  // Sauce-Dip/Beilage/Sonstiges, siehe REZEPT_KATEGORIEN in src/lib/rezeptKategorien.ts) —
  // der Tages-Auswahl im Essensplan zeigt standardmäßig nur "Hauptgang", mit Suche über alle.
  kategorie      String   @default("Hauptgang")
  createdAt      DateTime @default(now())

  planEintraege   EssensplanEintrag[]
  ausblendungen   RezeptAusblendung[]
  extraMahlzeiten ExtraMahlzeit[]
}

model EssensplanEintrag {
  id                        String   @id @default(cuid())
  familieId                 String?
  familie                   Familie? @relation(fields: [familieId], references: [id])
  wocheStart                DateTime // Samstag der jeweiligen Woche
  tag                       DateTime
  rezeptId                  String
  rezept                    Rezept   @relation(fields: [rezeptId], references: [id])
  esserIds                  String[] @default([])
  esserFaktor               Float    @default(1)
  extraPortionen            Float    @default(0) // z.B. Gäste an dem Tag, zusätzlich zu den ausgewählten Essern
  gelockt                   Boolean  @default(false)
  // Fix-Batch 92 (Florians Wunsch): verhindert Doppel-Versand der Push-Erinnerung "morgen ist
  // das noch nicht eingekauft" (siehe pruefeUndSendeErinnerungen in dashboard/actions.ts).
  einkaufErinnerungGesendet Boolean  @default(false)

  herkuenfte EssensplanHerkunft[]
}

// Fix-Batch 80 (Florians Wunsch): zusätzliche, geplante Mahlzeiten an einem Tag NEBEN dem
// normalen Hauptgericht — z.B. Frühstück, ein zusätzliches warmes Essen oder ein Mittags-
// Snack. Bewusst ein eigenes, einfacheres Modell statt EssensplanEintrag zu verallgemeinern
// (keine Wer-isst-mit-Auswahl, kein Slot-Limit pro Tag) — die bestehende Tages-Logik (ein
// Hauptgericht) bleibt dadurch unangetastet.
// Fix-Batch 84 (Florians Bug-Meldung): Sperren/Herkunft NACHGERÜSTET, weil ohne das ein
// erneuter Klick auf "🛒 Zutaten" dieselbe Menge beliebig oft auf die Einkaufsliste
// draufaddiert hätte — jetzt exakt dieselbe Logik wie beim Hauptgericht (gelockt, erst nach
// Entsperren mit Entfernen/Behalten-Abfrage wieder änderbar/löschbar).
model ExtraMahlzeit {
  id                        String   @id @default(cuid())
  familieId                 String?
  familie                   Familie? @relation(fields: [familieId], references: [id])
  wocheStart                DateTime // Samstag der jeweiligen Woche, wie bei EssensplanEintrag
  tag                       DateTime
  bezeichnung               String // frei, z.B. "Frühstück", "Mittags-Snack", "Zusätzliches warmes Essen"
  rezeptId                  String
  rezept                    Rezept   @relation(fields: [rezeptId], references: [id])
  faktor                    Float    @default(1) // bezieht sich direkt auf die im Rezept geschriebene Menge
  gelockt                   Boolean  @default(false)
  // Fix-Batch 92: siehe Kommentar bei EssensplanEintrag.einkaufErinnerungGesendet.
  einkaufErinnerungGesendet Boolean  @default(false)
  createdAt                 DateTime @default(now())

  herkuenfte ExtraMahlzeitHerkunft[]
}

// Blendet ein Rezept aus den Vorschlägen für eine einzelne Woche aus (Fahrplan §3,
// Batch 5) — bewusst pro Woche statt global, damit es später wieder vorgeschlagen wird.
model RezeptAusblendung {
  id         String   @id @default(cuid())
  rezeptId   String
  rezept     Rezept   @relation(fields: [rezeptId], references: [id], onDelete: Cascade)
  wocheStart DateTime

  @@unique([rezeptId, wocheStart])
}

// Merkt sich, welcher Essensplan-Tag welche (skalierte) Menge zu welchem
// Einkaufslisten-Artikel beigetragen hat — Grundlage für den Entfernen/Behalten-Dialog,
// wenn ein Gericht in einer bereits gelockten Woche geändert wird (Fahrplan §3).
// Bekannte, bewusst in Kauf genommene Einschränkung: Wird beim "Entfernen" die Menge
// neu berechnet, fließen nur die noch bekannten Essensplan-Herkünfte ein — ein zufällig
// in denselben Artikel gemischter manueller Anteil (gleicher Name, andere Quelle) wird
// dabei nicht separat zurückgerechnet.
model EssensplanHerkunft {
  id        String            @id @default(cuid())
  artikelId String
  artikel   EinkaufsArtikel   @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  eintragId String
  eintrag   EssensplanEintrag @relation(fields: [eintragId], references: [id], onDelete: Cascade)
  menge     String?
  createdAt DateTime          @default(now())

  @@unique([artikelId, eintragId])
}

// Fix-Batch 84: dasselbe Herkunfts-Prinzip wie EssensplanHerkunft, nur für ExtraMahlzeit —
// Grundlage für den Entfernen/Behalten-Dialog beim Entsperren einer Zusatzmahlzeit.
model ExtraMahlzeitHerkunft {
  id              String          @id @default(cuid())
  artikelId       String
  artikel         EinkaufsArtikel @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  extraMahlzeitId String
  extraMahlzeit   ExtraMahlzeit   @relation(fields: [extraMahlzeitId], references: [id], onDelete: Cascade)
  menge           String?
  createdAt       DateTime        @default(now())

  @@unique([artikelId, extraMahlzeitId])
}

// ---------- Push-Benachrichtigungen (Fragenkatalog Frage 33, Batch 8) ----------
// Pro Gerät/Browser eine eigene Subscription (nicht pro Person insgesamt) — eine Person
// kann mehrere Geräte aktiviert haben, alle bekommen dieselbe Benachrichtigung.

model PushSubscription {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ---------- Ticketsystem für Fehlermeldungen/Verbesserungsvorschläge (Fix-Batch 26) ----------
// Jede Person kann per Spracheingabe oder Text ein Ticket einreichen (Einstellungen →
// "Fehler melden"); Eltern (nicht auf Florian technisch beschränkbar, da die App keine
// Sonderrechte zwischen einzelnen Elternteilen kennt, siehe Fragenkatalog) genehmigen/
// lehnen ab/setzen auf "in Umsetzung". "Umgesetzt" wird nicht automatisch erkannt, sondern
// von Claude Code beim tatsächlichen Umsetzen eines genehmigten Tickets manuell gesetzt
// (Teil des normalen FAHRPLAN.md-Workflows dieses Projekts).
enum TicketStatus {
  EINGEREICHT
  GENEHMIGT
  ABGELEHNT
  IN_UMSETZUNG
  UMGESETZT
}

model Ticket {
  id            String       @id @default(cuid())
  familieId     String?
  familie       Familie?     @relation(fields: [familieId], references: [id])
  titel         String
  beschreibung  String
  status        TicketStatus @default(EINGEREICHT)
  begruendung   String? // optionale Begründung der Eltern (v.a. bei Ablehnung)
  fotos         String[]     @default([]) // optionale Fotos/Screenshots zum Ticket (Fix-Batch 35, mehrere möglich)
  erstelltVonId String
  erstelltVon   Person       @relation(fields: [erstelltVonId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ---------- Hausreparaturen/Vermieterkommunikation (Fix-Batch 35 Nachtrag) ----------
// Mängel/Reparaturbedarf im Haus erfassen — mit Status, frei editierbaren Notizen, und der
// Unterscheidung ob der Vermieter zuständig ist oder die Familie es selbst erledigt. Bei
// Selbst-Erledigung lässt sich daraus eine normale Aufgabe für ein Familienmitglied anlegen
// (aufgabeId verweist dann auf die entstandene Aufgabe).
enum HausproblemStatus {
  GEMELDET
  IN_BEARBEITUNG
  ERLEDIGT
}

enum HausproblemZustaendigkeit {
  VERMIETER
  FAMILIE
}

model Hausproblem {
  id             String                    @id @default(cuid())
  familieId      String?
  familie        Familie?                  @relation(fields: [familieId], references: [id])
  titel          String
  beschreibung   String
  status         HausproblemStatus         @default(GEMELDET)
  zustaendigkeit HausproblemZustaendigkeit
  notizen        String?
  fotos          String[]                  @default([])
  aufgabeId      String?
  erstelltVonId  String
  erstelltVon    Person                    @relation(fields: [erstelltVonId], references: [id])
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
}

// ---------- Schulferien (Fix-Batch 27) ----------
// Statische Referenzdaten (aus src/lib/schulferienDaten.ts, jährlich per Deploy neu
// synchronisiert — analog dem Dienstkatalog-Vorlage-Mechanismus), nicht in der App editierbar.
model Schulferien {
  id                 String   @id @default(cuid())
  bundesland         String
  schuljahr          String // z.B. "2026/2027"
  typ                String // HERBST | WEIHNACHTEN | WINTER | OSTERN | PFINGSTEN | SOMMER
  start              DateTime
  ende               DateTime
  // Fix-Batch 92 (Florians Wunsch): verhindert Doppel-Versand der 7-Tage-Vorher-Push-
  // Erinnerung (siehe pruefeUndSendeErinnerungen in dashboard/actions.ts).
  erinnerungGesendet Boolean  @default(false)

  @@unique([bundesland, schuljahr, typ])
}
