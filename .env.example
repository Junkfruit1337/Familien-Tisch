# In Coolify unter "Environment Variables" der Application-Ressource setzen.
# DATABASE_URL zusammensetzen aus den Zugangsdaten der Postgres-Ressource "Familien-Tisch"
# (Coolify -> Projekt -> Ressource -> Credentials): postgresql://USER:PASSWORT@HOST:5432/DBNAME
DATABASE_URL="postgresql://postgres:CHANGE_ME@familien-tisch-db:5432/postgres"

# Für die Rezept-Erfassung per Foto (Batch 8) — API-Schlüssel von platform.claude.com
# (Settings -> API Keys), separat vom claude.ai-Abo. Ohne diesen Schlüssel funktioniert
# die restliche App normal, nur die Foto-Erkennung meldet dann einen Fehler.
ANTHROPIC_API_KEY="CHANGE_ME"

# Für Push-Benachrichtigungen (Batch 8) — einmalig erzeugtes Schlüsselpaar, NICHT pro
# Umgebung neu generieren (sonst funktionieren bereits aktivierte Geräte nicht mehr).
# Neu erzeugen mit: npx web-push generate-vapid-keys
# Ohne diese Schlüssel funktioniert die restliche App normal, nur ohne Push-Versand.
VAPID_PUBLIC_KEY="CHANGE_ME"
VAPID_PRIVATE_KEY="CHANGE_ME"
VAPID_SUBJECT="mailto:CHANGE_ME@example.com"
